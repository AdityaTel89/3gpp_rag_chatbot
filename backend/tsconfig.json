{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared": ["../shared/types/index.ts"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "../shared/**/*",
    "../eval/**/*"
  ],
  "ts-node": {
    "transpileOnly": true,
    "require": ["tsconfig-paths/register"]
  }
}