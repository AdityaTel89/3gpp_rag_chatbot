{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared": ["../shared/types/index.ts"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "../shared/**/*"
  ]
}